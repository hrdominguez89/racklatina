{% extends 'base_catalogo.html.twig' %}

{% block title %}{{ articulo.nombreDisplay }}{% endblock %}

{% block breadcrumb %}
<ol class="breadcrumb mb-0">
    <li class="breadcrumb-item">
        <a href="{{ path('app_catalogo_index') }}">Catálogo</a>
    </li>
    {% if articulo.categoriaAdvisor %}
    <li class="breadcrumb-item">
        <a href="{{ path('app_catalogo_lista', {categoria: articulo.categoriaAdvisor}) }}">{{ articulo.categoriaAdvisor }}</a>
    </li>
    {% endif %}
    <li class="breadcrumb-item active">{{ articulo.nombreDisplay|slice(0,40) }}{% if articulo.nombreDisplay|length > 40 %}…{% endif %}</li>
</ol>
{% endblock %}

{% block stylesheets %}
<style>
/* ── Imagen ── */
.det-img-wrap {
    background: #fff;
    border: 1px solid #ebebeb;
    border-radius: 8px;
    min-height: 420px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.det-img-wrap img {
    max-height: 380px;
    max-width: 100%;
    object-fit: contain;
    padding: 1.5rem;
}
.det-img-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #ccc;
    min-height: 380px;
}

/* ── Category tags ── */
.det-tags {
    display: flex;
    flex-wrap: wrap;
    gap: .4rem;
    margin-bottom: .85rem;
}
.det-tag {
    font-size: .75rem;
    font-weight: 600;
    color: var(--rkl-primary);
    background: #f5f5e0;
    border: 1px solid #e0dc9a;
    border-radius: 20px;
    padding: .2em .75em;
    letter-spacing: .2px;
}

/* ── En Stock badge ── */
.badge-stock {
    display: inline-block;
    background: var(--rkl-primary);
    color: #fff;
    font-size: .72rem;
    font-weight: 600;
    padding: .3em .9em;
    border-radius: 20px;
    letter-spacing: .3px;
}

/* ── Cantidad ── */
.qty-ctrl {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid #d0d0d0;
    border-radius: 4px;
    overflow: hidden;
}
.qty-ctrl button {
    background: #f5f5f5;
    border: none;
    width: 36px;
    font-size: 1.1rem;
    font-weight: 600;
    color: #333;
    cursor: pointer;
    line-height: 1;
    transition: background .12s;
}
.qty-ctrl button:hover { background: #e8e8e8; }
.qty-ctrl input {
    border: none;
    border-left: 1px solid #d0d0d0;
    border-right: 1px solid #d0d0d0;
    width: 52px;
    height: 36px;
    text-align: center;
    font-weight: 600;
    font-size: .9rem;
    background: #fff;
    outline: none;
    box-shadow: none;
    -moz-appearance: textfield;
}
.qty-ctrl input::-webkit-outer-spin-button,
.qty-ctrl input::-webkit-inner-spin-button { -webkit-appearance: none; }

/* ── Botones acción ── */
.det-actions {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
}
.btn-agregar-det {
    width: 100%;
    background: var(--rkl-primary);
    color: #fff;
    border: none;
    border-radius: 5px;
    padding: .45rem .9rem;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .7px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .15s;
    white-space: nowrap;
}
.btn-agregar-det:hover { background: var(--rkl-primary-dark); }
.btn-agregar-det--login { width: auto; display: inline-block; }
.btn-agregar-det--auto { width: auto; }
.btn-cotizacion-det {
    background: #fff;
    color: var(--rkl-primary);
    border: 1.5px solid var(--rkl-primary);
    border-radius: 5px;
    padding: .45rem .9rem;
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .7px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .15s, color .15s;
    white-space: nowrap;
}
.btn-cotizacion-det:hover { background: var(--rkl-primary); color: #fff; }

/* ── Dropdown proyectos ── */
.proyectos-dropdown-wrap {
    position: relative;
}
.proyectos-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    min-width: 220px;
    background: #fff;
    border: 1px solid #e0e0e0;
    border-radius: 6px;
    box-shadow: 0 4px 16px rgba(0,0,0,.1);
    z-index: 200;
    overflow: hidden;
}
.proyectos-dropdown.open { display: block; }
.proy-drop-item {
    display: block;
    width: 100%;
    padding: .6rem .9rem;
    font-size: .85rem;
    color: #333;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    transition: background .1s;
}
.proy-drop-item:hover { background: #f5f5f5; }
.proy-drop-item.loading { color: #aaa; cursor: default; }
.proy-drop-divider { height: 1px; background: #f0f0f0; margin: .25rem 0; }
.proy-drop-create {
    display: block;
    padding: .6rem .9rem;
    font-size: .82rem;
    font-weight: 600;
    color: var(--rkl-primary);
    text-decoration: none;
    transition: background .1s;
}
.proy-drop-create:hover { background: #f5f5f5; color: var(--rkl-primary-dark); }

/* ── Tabs ── */
.det-tabs-section {
    margin-top: 2.5rem;
    border-top: 1px solid #ebebeb;
    padding-top: 1.5rem;
}
.det-tab-nav {
    display: flex;
    justify-content: center;
    gap: 0;
    border-bottom: 2px solid #e8e8e8;
    margin-bottom: 1.25rem;
}
.det-tab-btn {
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    padding: .55rem 1.1rem;
    font-size: .85rem;
    font-weight: 600;
    color: #888;
    cursor: pointer;
    transition: color .15s, border-color .15s;
    white-space: nowrap;
}
.det-tab-btn:hover { color: #444; }
.det-tab-btn.active {
    color: var(--rkl-primary);
    border-bottom-color: var(--rkl-primary);
}
.det-tab-panel {
    display: none;
    font-size: .875rem;
    color: #555;
    line-height: 1.8;
    padding: 0 9rem;
}
.det-tab-panel.active { display: block; }
@media (max-width: 767px) {
    .det-tab-panel { padding: 0; }
}

/* ── Modal Cotización ── */
#modalCotizacion .modal-dialog {
    max-width: 580px;
}
#modalCotizacion .modal-content {
    border: none;
    border-radius: 12px;
    padding: 2rem 2.25rem 2.25rem;
}
#modalCotizacion .modal-title-cot {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--rkl-primary);
    line-height: 1.3;
    margin-bottom: .75rem;
}
#modalCotizacion .modal-subtitle-cot {
    font-size: .9rem;
    color: #666;
    line-height: 1.6;
    margin-bottom: 2rem;
}
#modalCotizacion .btn-cot-crear {
    display: block;
    width: 100%;
    background: var(--rkl-primary);
    color: #fff;
    border: none;
    border-radius: 6px;
    padding: .85rem 1rem;
    font-size: .78rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    cursor: pointer;
    transition: background .15s;
    margin-bottom: 1.25rem;
}
#modalCotizacion .btn-cot-crear:hover { background: var(--rkl-primary-dark); }
#modalCotizacion .btn-cot-solo {
    display: block;
    text-align: center;
    font-size: .875rem;
    font-weight: 500;
    color: #333;
    text-decoration: underline;
    cursor: pointer;
    background: none;
    border: none;
    width: 100%;
    padding: 0;
}
#modalCotizacion .btn-cot-solo:hover { color: var(--rkl-primary); }
#modalCotizacion .btn-close-cot {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    background: none;
    border: none;
    font-size: 1.3rem;
    color: #666;
    cursor: pointer;
    line-height: 1;
    padding: .25rem;
}
#modalCotizacion .btn-close-cot:hover { color: #111; }

/* ── Precio a consultar ── */
.precio-consultar {
    border: 1px solid #f0c040;
    border-radius: 6px;
    padding: .65rem .9rem;
    background: #fffdf0;
    display: inline-block;
    min-width: 180px;
}
.precio-consultar-badge {
    display: inline-flex;
    align-items: center;
    gap: .35rem;
    font-size: .85rem;
    font-weight: 600;
    color: #856404;
    border-left: 3px solid #f0c040;
    padding-left: .5rem;
}
.precio-consultar-badge i {
    font-size: 1rem;
}

/* ── Plazos / Disponibilidad y envíos ── */
.plazos-card {
    background: #f7f7f5;
    border-radius: 10px;
    overflow: hidden;
    margin-top: 1rem;
}
.plazos-card-header {
    display: flex;
    align-items: center;
    gap: .65rem;
    padding: 1rem 1.1rem .75rem;
}
.plazos-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #efe9b8;
    color: var(--rkl-primary);
    font-size: 1.05rem;
    flex-shrink: 0;
}
.plazos-card-title {
    font-weight: 700;
    font-size: .95rem;
    color: #1a1a1a;
}
.plazos-rows {
    padding: 0 1.1rem .9rem;
    display: flex;
    flex-direction: column;
    gap: .55rem;
}
.plazos-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .5rem .75rem;
    font-size: .85rem;
    color: #333;
}
.plazos-row .plazos-cant {
    font-weight: 700;
    min-width: 2.5rem;
}
.plazos-row .plazos-deposito {
    color: #777;
}
.plazos-row-status {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    margin-left: auto;
}
.plazos-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    display: inline-block;
}
.plazos-dot--ok { background: #3fa34d; }
.plazos-dot--pedido { background: #e0a800; }
.plazos-badge {
    font-size: .72rem;
    font-weight: 700;
    padding: .25em 1em;
    border-radius: 20px;
    white-space: nowrap;
}
.plazos-badge--ok {
    color: #2e7d32;
    background: #eaf7ec;
    border: 1px solid #bfe6c4;
}
.plazos-badge--pedido {
    color: #8a6100;
    background: #fff6df;
    border: 1px solid #f0d98a;
}
.plazos-footer {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    padding: .7rem 1.1rem;
    border-top: 1px solid #e8e8e4;
    font-size: .78rem;
    color: #777;
}
.plazos-footer i { font-size: .95rem; margin-top: .1rem; }
.plazos-msg {
    font-size: .85rem;
    color: #888;
    padding: .5rem 0;
    display: block;
}

/* ── Relacionados ── */
.rel-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid #ebebeb;
}
.rel-section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
}
.rel-section-header span {
    font-size: .95rem;
    font-weight: 700;
    color: #1a1a1a;
}
.rel-section-header a {
    font-size: .8rem;
    font-weight: 600;
    color: var(--rkl-primary);
    text-decoration: none;
}
.rel-section-header a:hover { text-decoration: underline; }
</style>
{% endblock %}

{% block body %}
<h3 class="fw-semibold mb-4" style="color:#1a1a1a;">Productos</h3>

<div class="row g-4 g-lg-5">

    {# ── Columna imagen ── #}
    <div class="col-12 col-md-5">
        <div class="det-img-wrap">
            <img src="{{ articulo.imagenUrl }}"
                 alt="{{ articulo.nombreDisplay }}"
                 style="mix-blend-mode: multiply;"
                 onerror="this.onerror=null;this.src='{{ articulo.imagenFallbackUrl|e('html_attr') }}';">
        </div>
    </div>

    {# ── Columna info ── #}
    <div class="col-12 col-md-7">

        {# Tags de categoría #}
        {% if articulo.categoriaAdvisor or articulo.subcategoriaAdvisor %}
        <div class="det-tags">
            {% if articulo.categoriaAdvisor %}
            <span class="det-tag">{{ articulo.categoriaAdvisor }}</span>
            {% endif %}
            {% if articulo.subcategoriaAdvisor %}
            <span class="det-tag">{{ articulo.subcategoriaAdvisor }}</span>
            {% endif %}
        </div>
        {% endif %}

        {# Nombre #}
        <h4 class="fw-bold mb-2" style="color:#1a1a1a;line-height:1.3;font-size:1.3rem;">{{ articulo.nombreDisplay }}</h4>

        {# Descripción #}
        {% if articulo.descripcionAdvisor %}
        <p class="mb-3" style="font-size:.85rem;color:#666;line-height:1.65;">{{ articulo.descripcionAdvisor }}</p>
        {% endif %}

        {# Badges de tags (StockAdvisor) — solo roles con acceso a stock #}
        {% set puedeVerStock = is_granted('ROLE_COMPRADOR') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ADMINISTRACION') or is_granted('ROLE_INGENIERO_N1') or is_granted('ROLE_INGENIERO_N2') %}
        {% set puedeProyectos = is_granted('ROLE_COMPRADOR') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ADMINISTRACION') or is_granted('ROLE_INGENIERO_N1') or is_granted('ROLE_INGENIERO_N2') %}
        {% set _detTags = (puedeVerStock and stockAdvisor and stockAdvisor.tags) ? stockAdvisor.tags|split(',')|map(t => t|trim)|filter(t => t != '') : [] %}
        {% if puedeVerStock and (_detTags|length > 0 or stock is not null) %}
        <div class="mb-3 d-flex flex-wrap gap-2">
            {% for tag in _detTags %}
            <span class="badge-stock">{{ tag }}</span>
            {% endfor %}
            {% if stock is not null %}
            <span class="badge-stock">En Stock ({{ stock|number_format(0, ',', '.') }})</span>
            {% endif %}
        </div>
        {% endif %}

        {# Precio #}
        {% set puedeVerPrecio = is_granted('ROLE_COMPRADOR') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ADMINISTRACION') or is_granted('ROLE_INGENIERO_N2') %}
        {% if puedeVerPrecio %}
            {% if precio is not null and precio.precio is defined and precio.precio > 0 %}
            <div class="mb-3">
                <p class="mb-0" style="font-size:.72rem;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.4px;">Precio unitario (USD)</p>
                <p class="mb-0 fw-bold" style="font-size:1.5rem;color:#1a1a1a;">
                    U$S {{ precio.precio|number_format(2, ',', '.') }}
                </p>
            </div>
            {% else %}
            <div class="precio-consultar mb-3">
                <div class="precio-consultar-badge">
                    <i class="ri-alert-line"></i> Precio a consultar
                </div>
            </div>
            {% endif %}
        {% endif %}

        {# Cantidad #}
        <p class="mb-2" style="font-size:.78rem;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.4px;">Cantidad</p>
        <div class="qty-ctrl mb-0">
            <button type="button" id="btn-menos">−</button>
            <input type="number" id="input-cantidad" value="1" min="1" max="999">
            <button type="button" id="btn-mas">+</button>
        </div>

        {# Botones de acción #}
        {% set esIngenieroVista = is_granted('ROLE_INGENIERO_N1') or is_granted('ROLE_INGENIERO_N2') %}
        {% if puedeProyectos %}
        <div class="det-actions">
            {% if esIngenieroVista %}
            {# Ingenieros: una sola lista, sin dropdown — agrega directo #}
            <button type="button" class="btn-agregar-det btn-agregar-det--auto" id="btn-agregar-det" data-modo-ingeniero="1">
                Agregar a Lista
            </button>
            {% else %}
            {# AGREGAR con dropdown inline #}
            <div class="proyectos-dropdown-wrap">
                <button type="button" class="btn-agregar-det" id="btn-agregar-det">
                    Agregar a Proyecto
                </button>
                <div class="proyectos-dropdown" id="proy-dropdown">
                    <div id="proy-drop-list">
                        <button class="proy-drop-item loading" disabled>Cargando…</button>
                    </div>
                    <div class="proy-drop-divider"></div>
                    <a href="{{ path('app_proyectos_index') }}" class="proy-drop-create"
                       data-bs-toggle="modal" data-bs-target="#modalCrearProyecto">
                        + Crear Nuevo Proyecto
                    </a>
                </div>
            </div>
            {% endif %}

            {% if is_granted('ROLE_COMPRADOR') or is_granted('ROLE_ADMIN') or is_granted('ROLE_ADMINISTRACION') %}
            <button type="button" class="btn-cotizacion-det"
                    data-bs-toggle="modal" data-bs-target="#modalCotizacion">
                Solicitar Cotización
            </button>
            {% endif %}
        </div>

        {% if not esIngenieroVista and proyectos is empty %}
        <p class="mt-2 mb-0" style="font-size:.8rem;color:#999;">
            <a href="{{ path('app_proyectos_index') }}" class="fw-semibold" style="color:var(--rkl-primary);">Creá un proyecto</a>
            para poder agregar productos.
        </p>
        {% endif %}

        {% elseif not app.user %}
        <div class="det-actions">
            <a href="{{ path('app_login', {redirect: app.request.requestUri}) }}" class="btn-agregar-det btn-agregar-det--login text-center text-decoration-none">
                Iniciá sesión para agregar
            </a>
        </div>
        {% endif %}

        {# Meta (código, marca) #}
        {% if articulo.codigoCalipso or articulo.marca %}
        <div class="mt-3 d-flex align-items-center flex-wrap gap-2">
            {% if articulo.codigoCalipso %}
            <span style="font-size:1rem;color:#555;">Cód: <strong style="color:#1a1a1a;">{{ articulo.codigoRockwell ?: articulo.codigoCalipso }}</strong></span>
            {% endif %}
            {% if articulo.marca %}
            <span style="font-size:.78rem;color:#aaa;">{{ articulo.marca }}</span>
            {% endif %}
        </div>
        {% endif %}

    </div>{# /col-md-7 #}
</div>{# /row #}

{# ── Tabs de información ── #}
<div class="det-tabs-section">
    <div class="det-tab-nav">
        <button class="det-tab-btn active" data-tab="descripcion">Descripción</button>
        <button class="det-tab-btn" data-tab="caracteristicas">Características</button>
        <button class="det-tab-btn" data-tab="seleccion">Selección de productos</button>
        <button class="det-tab-btn" data-tab="envios">Disponibilidad y entregas</button>
    </div>

    <div class="det-tab-panel active" id="tab-descripcion">
        {% if articulo.descripcionAdvisor %}
            <p>{{ articulo.descripcionAdvisor }}</p>
        {% endif %}
        {% if articulo.soluciones %}
            <p>{{ articulo.soluciones }}</p>
        {% endif %}
        {% if not articulo.descripcionAdvisor and not articulo.soluciones %}
            <p class="text-muted">Sin descripción disponible.</p>
        {% endif %}
    </div>

    <div class="det-tab-panel" id="tab-caracteristicas">
        {% if articulo.descripcionTecnica %}
            {{ articulo.descripcionTecnica|nl2br }}
        {% else %}
            <p class="text-muted">Sin información técnica disponible.</p>
        {% endif %}
    </div>

    <div class="det-tab-panel" id="tab-seleccion">
        <p>Agregá este producto a {{ esIngenieroVista ? 'una de tus listas' : 'uno de tus proyectos' }} para gestionarlo junto con otros artículos.</p>
        {% if app.user %}
        <a href="{{ path('app_proyectos_index') }}" class="fw-semibold" style="color:var(--rkl-primary);">
            {{ esIngenieroVista ? 'Ver mis listas →' : 'Ver mis proyectos →' }}
        </a>
        {% endif %}
    </div>

    <div class="det-tab-panel" id="tab-envios">
        {% if puedeVerStock %}
        <div id="plazos-wrap">
            <button type="button" class="btn-cotizacion-det" id="btn-consultar-plazos" disabled>Refrescar</button>
            <div id="plazos-resultado" class="mt-3"></div>
        </div>
        {% else %}
        <p>Para información sobre envíos y tiempos de entrega, contactate con tu representante comercial.</p>
        {% endif %}
    </div>
</div>

{# ── Relacionados ── #}
{% if relacionados is not empty %}
<div class="rel-section">
    <div class="rel-section-header">
        <span>Productos más recomendados</span>
        {% if articulo.categoriaAdvisor %}
        <a href="{{ path('app_catalogo_lista', {categoria: articulo.categoriaAdvisor}) }}">ver más →</a>
        {% endif %}
    </div>
    <div class="row g-3">
        {% for rel in relacionados %}
        <div class="col-6 col-md-3">
            {% include 'secure/external/catalogo/_card_articulo.html.twig' with {articulo: rel, proyectos: proyectos} %}
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

{# ── Modal: Solicitar Cotización ── #}
<div class="modal fade" id="modalCotizacion" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content position-relative">
            <button type="button" class="btn-close-cot" data-bs-dismiss="modal" aria-label="Cerrar">
                &#x2715;
            </button>

            <p class="modal-title-cot">¿Querés cotizar solo este producto?</p>
            <p class="modal-subtitle-cot">
                Si agregás este producto a un proyecto, vas a poder cotizar todo junto en un solo documento.
            </p>

            <button type="button" class="btn-cot-crear" id="btn-cot-crear-proyecto" data-bs-dismiss="modal">
                Crear Proyecto
            </button>

            <button type="button" class="btn-cot-solo" id="btn-cot-solo" data-bs-dismiss="modal">
                Cotizar solo este producto
            </button>
        </div>
    </div>
</div>

{% endblock %}

{% block extra_js %}
<script>
(function() {
    const articuloCodigo = '{{ articulo.codigoCalipso|e('js') }}';

    RKL.clarity('event', 'producto_visto');
    RKL.clarity('set', 'producto_visto', articuloCodigo);

    // ── Cantidad +/- ──
    document.getElementById('btn-menos')?.addEventListener('click', () => {
        const inp = document.getElementById('input-cantidad');
        if (parseInt(inp.value) > 1) inp.value = parseInt(inp.value) - 1;
        inp.dispatchEvent(new Event('input'));
    });
    document.getElementById('btn-mas')?.addEventListener('click', () => {
        const inp = document.getElementById('input-cantidad');
        if (parseInt(inp.value) < 999) inp.value = parseInt(inp.value) + 1;
        inp.dispatchEvent(new Event('input'));
    });

    // ── Agregar artículo a un proyecto ──
    async function agregarArticulo(proyectoId, cantidad, btnOrigen) {
        if (btnOrigen) btnOrigen.disabled = true;
        const fd = new FormData();
        fd.append('articulo_codigo', articuloCodigo);
        fd.append('cantidad', cantidad || 1);
        try {
            const res  = await fetch(`/secure/proyectos/${proyectoId}/agregar-articulo`, { method: 'POST', body: fd });
            const data = await res.json();
            if (data.success) {
                RKL.clarity('event', 'producto_agregado');
                RKL.clarity('set', 'producto_agregado', articuloCodigo);
                RKL.toast(data.mensaje
                    + ` <a href="/secure/proyectos/${proyectoId}" class="fw-semibold" style="white-space:nowrap;">Ver proyecto →</a>`,
                    'success');
            } else {
                RKL.toast(data.error || 'Error al agregar', 'danger');
            }
        } catch (e) {
            RKL.toast('Error: ' + e.message, 'danger');
        } finally {
            if (btnOrigen) btnOrigen.disabled = false;
        }
    }

    // ── Dropdown inline de proyectos ──
    const btnAgregar  = document.getElementById('btn-agregar-det');
    const dropdown    = document.getElementById('proy-dropdown');
    const dropList    = document.getElementById('proy-drop-list');
    let dropLoaded    = false;

    async function cargarDropdown() {
        if (dropLoaded) return;
        dropList.innerHTML = '<button class="proy-drop-item loading" disabled>Cargando…</button>';
        try {
            const proyectos = await fetch('/secure/proyectos/mis-proyectos-json').then(r => r.json());
            dropLoaded = true;
            if (proyectos.length === 0) {
                dropList.innerHTML = '<span class="proy-drop-item loading">Sin proyectos</span>';
            } else {
                dropList.innerHTML = proyectos.map(p =>
                    `<button class="proy-drop-item" data-id="${p.id}">${p.nombre}</button>`
                ).join('');
                dropList.querySelectorAll('.proy-drop-item').forEach(btn => {
                    btn.addEventListener('click', function() {
                        const cantidad = parseInt(document.getElementById('input-cantidad')?.value || 1);
                        dropdown.classList.remove('open');
                        agregarArticulo(this.dataset.id, cantidad, btnAgregar);
                    });
                });
            }
        } catch {
            dropList.innerHTML = '<span class="proy-drop-item loading">Error al cargar</span>';
        }
    }

    btnAgregar?.addEventListener('click', async function(e) {
        e.stopPropagation();

        // Ingenieros: flujo auto-create sin dropdown
        if (this.dataset.modoIngeniero === '1') {
            const fd = new FormData();
            fd.append('articulo_codigo', articuloCodigo);
            fd.append('cantidad', parseInt(document.getElementById('input-cantidad')?.value || 1));
            this.disabled = true;
            try {
                const res  = await fetch('/secure/proyectos/agregar-automatico', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    RKL.proyectoActivo = data.proyecto;
                    RKL.clarity('event', 'producto_agregado');
                    RKL.clarity('set', 'producto_agregado', articuloCodigo);
                    RKL.toast(data.mensaje
                        + ` <a href="/secure/proyectos/${data.proyecto.id}" class="fw-semibold" style="white-space:nowrap;">Ver proyecto →</a>`,
                        'success');
                } else {
                    RKL.toast(data.error || 'Error al agregar', 'danger');
                }
            } catch (err) {
                RKL.toast('Error: ' + err.message, 'danger');
            } finally {
                this.disabled = false;
            }
            return;
        }

        const isOpen = dropdown.classList.contains('open');
        if (isOpen) {
            dropdown.classList.remove('open');
            return;
        }
        // Si hay proyecto activo, agregar directo sin abrir dropdown
        if (RKL.proyectoActivo) {
            const cantidad = parseInt(document.getElementById('input-cantidad')?.value || 1);
            agregarArticulo(RKL.proyectoActivo.id, cantidad, this);
            return;
        }
        await cargarDropdown();
        dropdown.classList.add('open');
    });

    // Cerrar dropdown al hacer click afuera
    document.addEventListener('click', function(e) {
        if (dropdown && !dropdown.closest('.proyectos-dropdown-wrap').contains(e.target)) {
            dropdown.classList.remove('open');
        }
    });

    // ── Disponibilidad y entregas ──
    const btnRefrescarPlazos = document.getElementById('btn-consultar-plazos');
    let plazosCantidadConsultada = null;
    let plazosCargado = false;

    async function cargarPlazos() {
        const resultDiv = document.getElementById('plazos-resultado');
        const cantidad  = parseInt(document.getElementById('input-cantidad')?.value || 1);
        if (!btnRefrescarPlazos || !resultDiv) return;

        btnRefrescarPlazos.disabled = true;
        resultDiv.innerHTML = '<span class="plazos-msg">Consultando…</span>';
        try {
            const params = new URLSearchParams({ cantidad });
            const res  = await fetch(`/catalogo/productos/${articuloCodigo}/plazos?${params}`);
            const data = await res.json();

            plazosCantidadConsultada = cantidad;
            plazosCargado = true;

            if (data.error) {
                resultDiv.innerHTML = `<span class="plazos-msg" style="color:#c00;">${data.error}</span>`;
                return;
            }

            if (data.consultarPlazos) {
                resultDiv.innerHTML = '<span class="plazos-msg">Plazo a consultar. Contactate con tu representante comercial.</span>';
                return;
            }

            let rows = '';
            let cubierto = 0;
            for (const i of data.items) {
                const dotClass   = i.disponible ? 'plazos-dot--ok' : 'plazos-dot--pedido';
                const badgeClass = i.disponible ? 'plazos-badge--ok' : 'plazos-badge--pedido';
                const badgeTexto = i.disponible ? 'En stock' : 'Bajo pedido';
                rows += `
                    <div class="plazos-row">
                        <span class="plazos-cant">${i.cantidad} u.</span>
                        <span>para el ${i.fechaEntrega}</span>
                        ${i.depositoNombre ? `<span class="plazos-deposito">— ${i.depositoNombre}</span>` : ''}
                        <span class="plazos-row-status">
                            <span class="plazos-dot ${dotClass}"></span>
                            <span class="plazos-badge ${badgeClass}">${badgeTexto}</span>
                        </span>
                    </div>`;
                cubierto += i.cantidad;
            }
            const restante = data.cantidadSolicitada - cubierto;
            if (restante > 0) {
                rows += `
                    <div class="plazos-row">
                        <span class="plazos-cant">${restante} u.</span>
                        <span class="plazos-deposito">a consultar</span>
                    </div>`;
            }

            if (!rows) {
                resultDiv.innerHTML = '<span class="plazos-msg">Sin información disponible.</span>';
                return;
            }

            resultDiv.innerHTML = `
                <div class="plazos-card">
                    <div class="plazos-card-header">
                        <span class="plazos-card-icon"><i class="ri-truck-line"></i></span>
                        <span class="plazos-card-title">Disponibilidad y entregas</span>
                    </div>
                    <div class="plazos-rows">${rows}</div>
                    <div class="plazos-footer">
                        <i class="ri-information-line"></i>
                        <span>Las fechas pueden variar según confirmación de stock con el fabricante. Sujeto a disponibilidad.</span>
                    </div>
                </div>`;
        } catch (e) {
            resultDiv.innerHTML = '<span class="plazos-msg" style="color:#c00;">Error al consultar plazos.</span>';
        } finally {
            btnRefrescarPlazos.disabled = true;
        }
    }

    btnRefrescarPlazos?.addEventListener('click', cargarPlazos);

    // Habilita "Refrescar" solo cuando la cantidad cambia respecto de la última consulta
    document.getElementById('input-cantidad')?.addEventListener('input', function() {
        const cantidadActual = parseInt(this.value || 1);
        if (btnRefrescarPlazos) {
            btnRefrescarPlazos.disabled = !plazosCargado || cantidadActual === plazosCantidadConsultada;
        }
    });

    // ── Tabs ──
    document.querySelectorAll('.det-tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            document.querySelectorAll('.det-tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.det-tab-panel').forEach(p => p.classList.remove('active'));
            this.classList.add('active');
            document.getElementById('tab-' + this.dataset.tab).classList.add('active');

            if (this.dataset.tab === 'envios' && !plazosCargado) {
                cargarPlazos();
            }
        });
    });

    // ── Modal Cotización ──
    document.getElementById('btn-cot-crear-proyecto')?.addEventListener('click', function() {
        // Abre modal de crear proyecto (Bootstrap)
        const modalCrear = new bootstrap.Modal(document.getElementById('modalCrearProyecto'));
        modalCrear.show();
    });

    document.getElementById('btn-cot-solo')?.addEventListener('click', function() {
        // Cotizar solo este producto: agrega al carrito de cotización y redirige
        const cantidad = parseInt(document.getElementById('input-cantidad')?.value || 1);
        const params = new URLSearchParams({ articulo: articuloCodigo, cantidad });
        window.location.href = `/secure/cotizacion/nueva?${params}`;
    });

})();
</script>
{% endblock extra_js %}
