</div>

{% endblock %}

{% block extra_js %}
<script>
(function () {

    const isFinished  = {{ isFinished ? 'true' : 'false' }};
    const proyectoId  = {{ proyecto.id }};
    const canVerPrecio = {{ canVerPrecio ? 'true' : 'false' }};

    // ── Carga asíncrona de leadtimes al renderizar la página ──
    (function () {
        if (isFinished) return;

        fetch(`/secure/proyectos/${proyectoId}/leadtimes-json`)
            .then(r => r.json())
            .then(data => {
                // data = { itemId: { consultarPlazos, items: [...] }, ... }
                for (const [itemId, lt] of Object.entries(data)) {
                    renderLeadtimeCell(parseInt(itemId), lt);
                }
            })
            .catch(() => {
                // En caso de error de red, mostrar "Consultar plazos" en todas las celdas
                document.querySelectorAll('.leadtime-spinner').forEach(el => {
                    el.closest('td').innerHTML = '<span style="font-size:.75rem;color:#888;">Consultar plazos</span>';
                });
            });
    })();

    // ── Carga asíncrona de precios al renderizar la página ──
    (function () {
        if (isFinished || !canVerPrecio) return;

        fetch(`/secure/proyectos/${proyectoId}/precios-json`)
            .then(r => r.json())
            .then(data => {
                // data = { itemId: { articulo, precio, precioTotal } | null, ... }
                for (const [itemId, precio] of Object.entries(data)) {
                    renderPrecioCell(parseInt(itemId), precio);
                }
                recalcularTotales();
            })
            .catch(() => {
                document.querySelectorAll('.precio-spinner').forEach(el => {
                    el.closest('td').innerHTML = '<span style="color:#bbb;font-size:.8rem;">N/D</span>';
                });
            });
    })();

    // ── Solicitar cotización ──
    (function () {
        const btnSolicitar = document.getElementById('btn-solicitar-pedido');
        if (!btnSolicitar) return;

        const modalEl = document.getElementById('modalSolicitarCotizacion');
        const bsModal  = bootstrap.Modal.getOrCreateInstance(modalEl);

        btnSolicitar.addEventListener('click', function () {
            RKL.clarity('event', 'solicitar_pedido');
            RKL.clarity('set', 'proyecto_cotizado', this.dataset.proyectoId);
            bsModal.show();
        });

        document.getElementById('btn-confirmar-cotizacion').addEventListener('click', async function () {
            const btn = this;
            btn.disabled = true;
            btn.innerHTML = '<i class="ri-loader-4-line me-1"></i> Enviando…';

            const proyectoId = btnSolicitar.dataset.proyectoId;
            const csrf       = btnSolicitar.dataset.csrf;
            const fd = new FormData();
            fd.append('_token', csrf);

            try {
                const res  = await fetch(`/secure/proyectos/${proyectoId}/solicitar-cotizacion`, { method: 'POST', body: fd });
                const data = await res.json();
                bsModal.hide();
                if (data.success) {
                    RKL.toast('Solicitud enviada correctamente. Nos comunicaremos a la brevedad.', 'success');
                    setTimeout(() => location.reload(), 1800);
                } else {
                    RKL.toast(data.error || 'Error al enviar la solicitud.', 'danger');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ri-mail-send-line me-1"></i> Enviar solicitud';
                }
            } catch {
                bsModal.hide();
                RKL.toast('Error de red. Por favor intentá nuevamente.', 'danger');
                btn.disabled = false;
                btn.innerHTML = '<i class="ri-mail-send-line me-1"></i> Enviar solicitud';
            }
        });
    })();

    // ── Formato numérico argentino (2 decimales, . miles, , decimal) ──
    function fmtUSD(n) {
        return 'U$S ' + n.toFixed(2)
            .replace('.', ',')
            .replace(/\B(?=(\d{3})+(?!\d))/g, '.');
    }

    // ── Recalcula totales por fila y el total del sidebar ──
    function recalcularTotales() {
        let totalGlobal = 0;
        let hayAlgunPrecio = false;

        document.querySelectorAll('.tr-producto').forEach(row => {
            const precioUnit = parseFloat(row.dataset.precioUnit);
            if (isNaN(precioUnit) || precioUnit <= 0) return;

            const input    = row.querySelector('.input-item-cantidad');
            const cantidad = input ? Math.max(1, parseInt(input.value) || 1) : 1;
            const rowTotal = precioUnit * cantidad;
            const totalCell = row.querySelector('.td-precio-total');

            if (totalCell) totalCell.textContent = fmtUSD(rowTotal);
            totalGlobal += rowTotal;
            hayAlgunPrecio = true;
        });

        const wrap    = document.getElementById('sidebar-total-wrap');
        const display = document.getElementById('sidebar-total-usd');
        if (wrap && display) {
            if (hayAlgunPrecio) {
                display.textContent = fmtUSD(totalGlobal);
                wrap.style.display = '';
            } else {
                wrap.style.display = 'none';
            }
        }
    }

    // ── Renderiza la celda de precio unitario y actualiza data-precio-unit ──
    function renderPrecioCell(itemId, precio) {
        const cell = document.getElementById(`precio-unit-cell-${itemId}`);
        if (!cell) return;

        const row = document.querySelector(`.tr-producto[data-item-id="${itemId}"]`);

        if (!precio || precio.precio <= 0) {
            cell.innerHTML = '<span style="color:#888;font-size:.8rem;">Consultar precio</span>';
            if (row) row.dataset.precioUnit = '';
            return;
        }

        cell.textContent = `U$S ${precio.precio.toFixed(2).replace('.', ',').replace(/\B(?=(\d{3})+(?!\d))/g, '.')}`;
        if (row) row.dataset.precioUnit = precio.precio;
    }

    // ── Spinner HTML para celdas de leadtime ──
    const LEADTIME_SPINNER_HTML = `
        <span class="leadtime-spinner">
            <span class="spinner-border spinner-border-sm text-secondary" role="status"
                  style="width:.85rem;height:.85rem;border-width:.15em;vertical-align:middle;"></span>
            <span style="font-size:.75rem;color:#888;margin-left:.3rem;">Calculando…</span>
        </span>`;

    // ── Renderiza la celda de leadtime a partir del objeto devuelto por el servidor ──
    function renderLeadtimeCell(itemId, lt) {
        const cell = document.getElementById(`leadtime-cell-${itemId}`);
        if (!cell) return;

        if (!lt) {
            cell.innerHTML = '<span style="color:#bbb;font-size:.78rem;">N/D</span>';
            return;
        }

        const cantidadSolicitada = lt.cantidadSolicitada ?? 0;

        if (lt.consultarPlazos) {
            const txt = cantidadSolicitada > 0 ? `${cantidadSolicitada} U. a consultar` : 'A consultar';
            cell.innerHTML = `<span style="font-size:.75rem;color:#888;">${txt}</span>`;
            return;
        }

        let html = '';
        let cubierto = 0;
        for (const i of lt.items) {
            html += `<span style="font-size:.75rem;color:#333;display:block;">${i.cantidad} U. para el ${i.fechaEntrega}</span>`;
            cubierto += i.cantidad;
        }
        const restante = cantidadSolicitada - cubierto;
        if (restante > 0) {
            html += `<span style="font-size:.75rem;color:#888;display:block;">${restante} U. a consultar</span>`;
        }
        cell.innerHTML = html || '<span style="color:#bbb;font-size:.78rem;">N/D</span>';
    }

    // ── Actualizar cantidad vía AJAX ──
    async function actualizarCantidad(itemId, cantidad, inputEl) {
        const prevValue = inputEl ? parseInt(inputEl.dataset.prev) : null;

        // Mostrar spinner en la celda de leadtime mientras se recalcula
        const cell = document.getElementById(`leadtime-cell-${itemId}`);
        if (cell) cell.innerHTML = LEADTIME_SPINNER_HTML;

        const fd = new FormData();
        fd.append('cantidad', cantidad);
        const res = await fetch(`/secure/proyectos/item/${itemId}/cantidad`, { method: 'POST', body: fd });
        if (!res.ok) {
            const data = await res.json().catch(() => ({}));
            if (inputEl && prevValue !== null) {
                inputEl.value = prevValue;
                sincronizarBotonesMas(inputEl);
                recalcularTotales();
            }
            // Restaurar celda de leadtime al estado anterior
            renderLeadtimeCell(itemId, { consultarPlazos: true, items: [] });
            if (res.status === 422) {
                RKL.toast(data.error || 'Stock insuficiente.', 'danger');
            } else if (res.status === 403) {
                RKL.toast('No tenés permiso para modificar este proyecto.', 'danger');
            }
        } else {
            const data = await res.json().catch(() => ({}));
            if (inputEl) {
                inputEl.dataset.prev = cantidad;
                sincronizarBotonesMas(inputEl);
            }
            if (data.leadtime !== undefined) {
                renderLeadtimeCell(itemId, data.leadtime);
            }
            if (canVerPrecio && data.precio !== undefined) {
                renderPrecioCell(itemId, data.precio);
                recalcularTotales();
            }
        }
    }

    // ── Sincroniza estado visual del botón + (sin deshabilitar, el aviso se da por toast) ──
    function sincronizarBotonesMas(inputEl) {
        // No se deshabilita: el aviso de stock agotado se muestra como toast al hacer click.
    }

    if (isFinished) return;

    // ── Guardar reemplazo (precio / plazo) vía AJAX ──
    document.querySelectorAll('.input-item-reemplazo').forEach(chk => {
        chk.addEventListener('change', async function () {
            const fd = new FormData();
            fd.append('tipo', this.dataset.type);
            fd.append('valor', this.checked ? '1' : '0');
            try {
                await fetch(`/secure/proyectos/item/${this.dataset.item}/reemplazo`, { method: 'POST', body: fd });
            } catch {
                RKL.toast('Error al guardar la opción de reemplazo.', 'danger');
            }
        });
    });

    // ── Modal eliminar item ──
    let pendingDeleteId  = null;
    let pendingDeleteUrl = null;
    const _modalEl = document.getElementById('modalEliminarItem');
    const _bsModal = bootstrap.Modal.getOrCreateInstance(_modalEl);

    function abrirModalEliminar(id) {
        const row    = document.querySelector(`.tr-producto[data-item-id="${id}"]`);
        const btn    = row ? row.querySelector('.btn-quitar-item') : null;
        const nombre = btn ? btn.dataset.nombre : 'Este producto';
        pendingDeleteId  = id;
        pendingDeleteUrl = btn?.dataset.url ?? `/secure/proyectos/item/${id}/quitar`;
        document.getElementById('modal-item-nombre').textContent = nombre;
        _bsModal.show();
    }

    document.getElementById('btn-confirmar-eliminar-item').addEventListener('click', async function () {
        if (!pendingDeleteId) return;
        const id  = pendingDeleteId;
        const url = pendingDeleteUrl;
        pendingDeleteId  = null;
        pendingDeleteUrl = null;
        _bsModal.hide();
        if (!url) { RKL.toast('Error: URL no encontrada.', 'danger'); return; }
        try {
            const fd   = new FormData();
            const res  = await fetch(url, { method: 'POST', body: fd });
            const text = await res.text();
            console.log('[quitar-item] status:', res.status, 'body:', text);
            let data;
            try { data = JSON.parse(text); } catch { data = null; }
            if (data?.success) {
                const rowProducto  = document.querySelector(`.tr-producto[data-item-id="${id}"]`);
                const rowSimilares = document.getElementById(`similares-${id}`);
                rowSimilares?.remove();
                rowProducto?.remove();
                actualizarSidebar();
                recalcularTotales();
                if (!document.querySelector('.tr-producto')) location.reload();
            } else {
                RKL.toast(data?.error || `Error ${res.status} al eliminar.`, 'danger');
            }
        } catch (e) {
            console.error('[quitar-item] excepción:', e);
            RKL.toast('Error de red al eliminar el producto.', 'danger');
        }
    });

    // ── Botón − (decrementar) ──
    document.querySelectorAll('.btn-item-menos').forEach(btn => {
        btn.addEventListener('click', function () {
            const id    = this.dataset.item;
            const input = document.querySelector(`.input-item-cantidad[data-item="${id}"]`);
            const val   = parseInt(input.value);
            if (val > 1) {
                input.value = val - 1;
                recalcularTotales();
                actualizarCantidad(id, input.value, input);
            } else {
                abrirModalEliminar(id);
            }
        });
    });

    // ── Botón + (incrementar) ──
    document.querySelectorAll('.btn-item-mas').forEach(btn => {
        btn.addEventListener('click', function () {
            if (this.disabled) return;
            const id    = this.dataset.item;
            const input = document.querySelector(`.input-item-cantidad[data-item="${id}"]`);
            if (!input) return;
            input.value = parseInt(input.value) + 1;
            recalcularTotales();
            actualizarCantidad(id, input.value, input);
        });
    });

    // ── Cambio manual de input ──
    document.querySelectorAll('.input-item-cantidad').forEach(input => {
        input.addEventListener('change', function () {
            const v = Math.max(1, parseInt(this.value) || 1);
            this.value = v;
            recalcularTotales();
            actualizarCantidad(this.dataset.item, v, this);
        });
    });

    // ── Quitar item ──
    document.querySelectorAll('.btn-quitar-item').forEach(btn => {
        btn.addEventListener('click', function () {
            abrirModalEliminar(this.dataset.item);
        });
    });

    // ── Actualizar sidebar (contador) ──
    function actualizarSidebar() {
        const n = document.querySelectorAll('.tr-producto').length;
        const countEl = document.getElementById('sidebar-items-count');
        if (countEl) countEl.textContent = n;
        const btnPedido = document.getElementById('btn-solicitar-pedido');
        if (btnPedido) btnPedido.disabled = n === 0;
    }

    // ── Guardar comentario vía AJAX ──
    let commentTimers = {};
    document.querySelectorAll('.input-item-comment').forEach(ta => {
        ta.addEventListener('input', function () {
            const id     = this.dataset.item;
            const status = document.querySelector(`.comment-status[data-item="${id}"]`);
            clearTimeout(commentTimers[id]);
            if (status) status.textContent = 'Escribiendo…';
            commentTimers[id] = setTimeout(async () => {
                const fd = new FormData();
                fd.append('comment', this.value);
                try {
                    const res  = await fetch(`/secure/proyectos/item/${id}/comment`, { method: 'POST', body: fd });
                    const data = await res.json();
                    if (status) status.textContent = data.success ? 'Guardado ✓' : 'Error al guardar';
                    if (data.success) setTimeout(() => { if (status) status.textContent = ''; }, 2000);
                } catch {
                    if (status) status.textContent = 'Error al guardar';
                }
            }, 700);
        });
    });

})();
</script>
{% endblock %}
