<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tu solicitud de presupuesto fue enviada</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #ebebeb;
            font-family: Arial, Helvetica, sans-serif;
            color: #1a1a1a;
        }
        .outer {
            background: #ebebeb;
            padding: 40px 20px;
        }
        .card {
            background: #ffffff;
            border-radius: 12px;
            max-width: 620px;
            margin: 0 auto;
            overflow: hidden;
            box-shadow: 0 2px 12px rgba(0,0,0,.07);
        }
        .card-body {
            padding: 48px 48px 36px;
        }
        .logo-wrap {
            text-align: center;
            margin-bottom: 40px;
        }
        .logo-wrap img {
            height: 44px;
        }
        .headline {
            font-size: 22px;
            font-weight: 400;
            line-height: 1.4;
            margin: 0 0 6px;
            color: #1a1a1a;
        }
        .headline strong {
            font-weight: 700;
        }
        .subline {
            font-size: 13px;
            color: #444;
            margin: 0 0 28px;
        }
        .subline strong {
            font-weight: 700;
            color: #1a1a1a;
        }
        .section-label {
            font-size: 14px;
            font-weight: 700;
            color: #ACA300;
            margin: 0 0 12px;
        }
        /* ── Tabla ── */
        .items-table {
            width: 100%;
            border-collapse: collapse;
        }
        .items-table thead tr {
            background: #e8e8e8;
        }
        .items-table thead th {
            padding: 12px 16px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: #666;
            text-align: center;
        }
        .items-table thead th.col-producto {
            text-align: left;
        }
        .items-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #e8e8e8;
            font-size: 14px;
            vertical-align: middle;
        }
        .items-table tbody tr:last-child td {
            border-bottom: none;
        }
        .items-table tbody td.col-producto {
            font-weight: 600;
            color: #1a1a1a;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-cantidad {
            text-align: center;
            font-weight: 700;
            font-size: 16px;
            color: #1a1a1a;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-notas {
            color: #aaa;
            font-size: 13px;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-precio {
            text-align: right;
            white-space: nowrap;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-total {
            text-align: right;
            font-weight: 700;
            white-space: nowrap;
        }
        .items-table tfoot td {
            padding: 14px 16px;
            font-size: 14px;
            border-top: 2px solid #1a1a1a;
        }
        .items-table tfoot td.col-total-label {
            text-align: right;
            font-weight: 700;
            color: #444;
        }
        .items-table tfoot td.col-total-value {
            text-align: right;
            font-weight: 700;
            font-size: 16px;
            color: #1a1a1a;
            white-space: nowrap;
        }
        .precio-nd {
            color: #bbb;
            font-size: 12px;
        }
        .table-wrap {
            border: 1px solid #e8e8e8;
            border-radius: 6px;
            overflow: hidden;
            margin-bottom: 28px;
        }
        .status-highlight {
            font-size: 15px;
            font-weight: 700;
            color: #ACA300;
            margin: 0 0 12px;
        }
        .status-body {
            font-size: 14px;
            color: #333;
            line-height: 1.6;
            margin: 0 0 10px;
        }
        .status-body strong {
            font-weight: 700;
        }
        .cierre {
            font-size: 14px;
            color: #333;
            margin: 0;
        }
        /* ── Footer ── */
        .footer {
            background: #ACA300;
            padding: 22px 48px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .footer-social {
            display: flex;
            gap: 10px;
        }
        .footer-social a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            background: #f0f0f0;
            border-radius: 8px;
            text-decoration: none;
        }
        .footer-social a svg {
            width: 20px;
            height: 20px;
            fill: #555;
            display: block;
        }
        .footer-logo-img {
            height: 40px;
            width: auto;
        }
        .notas-tag {
            display: block;
            font-size: 9px;
            font-weight: 700;
            padding: 2px 5px;
            border-radius: 3px;
            margin-top: 3px;
            white-space: nowrap;
        }
        .tag-precio { background: #e8f4e8; color: #2d7a2d; }
        .tag-plazo  { background: #e8f0fe; color: #1a56c4; }
    </style>
</head>
<body>
<div class="outer">
<div class="card">

    <div class="card-body">

        <div class="logo-wrap">
            <img src="https://racklatina.com/wp-content/uploads/2020/08/logo-racklatina.png"
                 alt="Racklatina"
                 onerror="this.src='https://racklatina.com/wp-content/uploads/2020/08/logo-racklatina-light.png'">
        </div>

        <p class="headline">
            <strong>{{ usuario_nombre }}</strong> tu solicitud de presupuesto fue enviada con éxito.
        </p>
        <p class="subline">
            Número de pedido <strong>#{{ proyecto_id }}</strong> registrado el día
            <strong>{{ fecha|date('d/m/Y') }}</strong> a las <strong>{{ fecha|date('H:i') }}</strong> hs.
        </p>

        <p class="section-label">Detalle</p>

        <div class="table-wrap">
            <table class="items-table">
                <thead>
                    <tr>
                        <th class="col-producto">Producto</th>
                        <th>Cantidad</th>
                        <th>Notas</th>
                        <th>Precio unit. (USD)</th>
                        <th>Total (USD)</th>
                    </tr>
                </thead>
                <tbody>
                {% for item in items %}
                    <tr>
                        <td class="col-producto">{{ item.articulo.nombreDisplay }}</td>
                        <td class="col-cantidad">{{ item.cantidad }}</td>
                        <td class="col-notas">
                            {{ item.comment ?? '' }}
                            {% if item.reemplazoPrecio %}
                                <span class="notas-tag tag-precio">↔ Reemplazo<br>por precio</span>
                            {% endif %}
                            {% if item.reemplazoPlazo %}
                                <span class="notas-tag tag-plazo">↔ Reemplazo<br>por plazo</span>
                            {% endif %}
                            {% if not item.comment and not item.reemplazoPrecio and not item.reemplazoPlazo %}
                                <span style="color:#ccc;">—</span>
                            {% endif %}
                        </td>
                        <td class="col-precio">
                            {% if item.precioUnitarioUsd is not null %}
                                U$S {{ item.precioUnitarioUsd|number_format(2, ',', '.') }}
                            {% else %}
                                <span class="precio-nd">N/D</span>
                            {% endif %}
                        </td>
                        <td class="col-total">
                            {% if item.precioTotalUsd is not null %}
                                U$S {{ item.precioTotalUsd|number_format(2, ',', '.') }}
                            {% else %}
                                <span class="precio-nd">N/D</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
                {% if precio_total_usd is not null %}
                <tfoot>
                    <tr>
                        <td colspan="4" class="col-total-label">Total estimado</td>
                        <td class="col-total-value">U$S {{ precio_total_usd|number_format(2, ',', '.') }}</td>
                    </tr>
                </tfoot>
                {% endif %}
            </table>
        </div>

        <p class="status-highlight">Actualmente su pedido se encuentra en proceso de revisión.</p>
        <p class="status-body">
            En un plazo de <strong>[X días hábiles]</strong> recibirá una respuesta formal a su solicitud.
        </p>
        <p class="cierre">Quedamos a su disposición ante cualquier consulta o requerimiento adicional.</p>

    </div>

    <div class="footer">
        <div class="footer-social">
            <a href="https://www.facebook.com/racklatina" target="_blank" title="Facebook">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987H7.898v-2.89h2.54V9.845c0-2.505 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/>
                </svg>
            </a>
            <a href="https://www.instagram.com/racklatina" target="_blank" title="Instagram">
                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
            </a>
        </div>
        <div class="footer-logo">
            <img class="footer-logo-img" src="data:image/png;base64," alt="Racklatina">
        </div>
    </div>

</div>
</div>
</body>
</html>
