<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitud de presupuesto</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #ebebeb;
            font-family: Arial, Helvetica, sans-serif;
            color: #1a1a1a;
        }
        .outer {
            background: #ebebeb;
            padding: 40px 20px;
        }
        .card {
            background: #ffffff;
            border-radius: 12px;
            max-width: 680px;
            margin: 0 auto;
            padding: 48px 48px 40px;
            box-shadow: 0 2px 12px rgba(0,0,0,.07);
        }
        .logo-wrap {
            text-align: center;
            margin-bottom: 40px;
        }
        .logo-wrap img {
            height: 44px;
        }
        .headline {
            font-size: 22px;
            font-weight: 400;
            line-height: 1.4;
            margin: 0 0 28px;
            color: #1a1a1a;
        }
        .headline strong {
            font-weight: 700;
        }
        /* ── Tabla ── */
        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 4px;
        }
        .items-table thead tr {
            background: #e8e8e8;
        }
        .items-table thead th {
            padding: 12px 16px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            color: #666;
            text-align: center;
        }
        .items-table thead th.col-producto {
            text-align: left;
        }
        .items-table tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid #e8e8e8;
            font-size: 14px;
            vertical-align: middle;
        }
        .items-table tbody tr:last-child td {
            border-bottom: none;
        }
        .items-table tbody td.col-producto {
            font-weight: 600;
            color: #1a1a1a;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-cantidad {
            text-align: center;
            font-weight: 700;
            font-size: 16px;
            color: #1a1a1a;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-notas {
            text-align: left;
            color: #aaa;
            font-size: 13px;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-precio {
            text-align: right;
            white-space: nowrap;
            border-right: 1px solid #e8e8e8;
        }
        .items-table tbody td.col-total {
            text-align: right;
            font-weight: 700;
            white-space: nowrap;
        }
        .items-table tfoot td {
            padding: 14px 16px;
            font-size: 14px;
            border-top: 2px solid #1a1a1a;
        }
        .items-table tfoot td.col-total-label {
            text-align: right;
            font-weight: 700;
            color: #444;
        }
        .items-table tfoot td.col-total-value {
            text-align: right;
            font-weight: 700;
            font-size: 16px;
            color: #1a1a1a;
            white-space: nowrap;
        }
        /* outer border de la tabla */
        .table-wrap {
            border: 1px solid #e8e8e8;
            border-radius: 6px;
            overflow: hidden;
        }
        .precio-nd {
            color: #bbb;
            font-size: 12px;
        }
        .notas-tag {
            display: block;
            font-size: 9px;
            font-weight: 700;
            padding: 2px 5px;
            border-radius: 3px;
            margin-top: 3px;
            white-space: nowrap;
        }
        .tag-precio { background: #e8f4e8; color: #2d7a2d; }
        .tag-plazo  { background: #e8f0fe; color: #1a56c4; }
    </style>
</head>
<body>
<div class="outer">
<div class="card">

    <div class="logo-wrap">
        <img src="https://racklatina.com/wp-content/uploads/2020/08/logo-racklatina.png"
             alt="Racklatina"
             onerror="this.src='https://racklatina.com/wp-content/uploads/2020/08/logo-racklatina-light.png'">
    </div>

    <p class="headline">
        <strong>{{ empresa_nombre ?? usuario_nombre }}</strong> ha solicitado presupuesto de los siguientes productos:
    </p>

    <div class="table-wrap">
        <table class="items-table">
            <thead>
                <tr>
                    <th class="col-producto">Producto</th>
                    <th>Cantidad</th>
                    <th>Notas</th>
                    <th>Precio unit. (USD)</th>
                    <th>Total (USD)</th>
                </tr>
            </thead>
            <tbody>
            {% for item in items %}
                <tr>
                    <td class="col-producto">{{ item.articulo.nombreDisplay }}</td>
                    <td class="col-cantidad">{{ item.cantidad }}</td>
                    <td class="col-notas">
                        {{ item.comment ?? '' }}
                        {% if item.reemplazoPrecio %}
                            <span class="notas-tag tag-precio">↔ Reemplazo<br>por precio</span>
                        {% endif %}
                        {% if item.reemplazoPlazo %}
                            <span class="notas-tag tag-plazo">↔ Reemplazo<br>por plazo</span>
                        {% endif %}
                        {% if not item.comment and not item.reemplazoPrecio and not item.reemplazoPlazo %}
                            <span style="color:#ccc;">—</span>
                        {% endif %}
                    </td>
                    <td class="col-precio">
                        {% if item.precioUnitarioUsd is not null %}
                            U$S {{ item.precioUnitarioUsd|number_format(2, ',', '.') }}
                        {% else %}
                            <span class="precio-nd">N/D</span>
                        {% endif %}
                    </td>
                    <td class="col-total">
                        {% if item.precioTotalUsd is not null %}
                            U$S {{ item.precioTotalUsd|number_format(2, ',', '.') }}
                        {% else %}
                            <span class="precio-nd">N/D</span>
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
            {% if precio_total_usd is not null %}
            <tfoot>
                <tr>
                    <td colspan="4" class="col-total-label">Total estimado</td>
                    <td class="col-total-value">U$S {{ precio_total_usd|number_format(2, ',', '.') }}</td>
                </tr>
            </tfoot>
            {% endif %}
        </table>
    </div>

</div>
</div>
</body>
</html>
