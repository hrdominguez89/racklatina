{% extends 'base_public.html.twig' %}

{% block title %}Racklatina - Portal clientes
{% endblock %}

{% block body %}

	<!-- auth page content -->

	<!-- end row -->

		<div class="row justify-content-center"> <div class="col-8">
			<div class="card mt-4 card-bg-fill">

				<div class="card-body p-4">
					<div class="row">
						<div class="col-12 text-center mt-2 mb-4">
							<h4 class="text-rkl-secondary">Registro de clientes</h4>
							{# <p class="text-muted"></p> #}
						</div>
					</div>
					<div class="row">
						{{ form_start(form, {attr: {'data-turbo': 'false',class: 'needs-validation'}}) }}
						{% for error in form.vars.errors %}
							<div class="alert alert-danger">{{ error.message }}</div>
						{% endfor %}
						{% if form.vars.errors|length > 0 %}
							<div class="alert alert-danger">
								{{ form_errors(form) }}
							</div>
						{% endif %}
					</div>
						
					<div class="row">
						<div class="col-12 col-md-4 mb-3">
							{{ form_label(form.firstName) }}
							{{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.firstName) }}
						</div>
						<div class="col-12 col-md-4 mb-3">
							{{ form_label(form.lastName) }}
							{{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.lastName) }}
						</div>
						<div class="col-12 col-md-4 mb-3">
							{{ form_label(form.phoneNumber) }}
							{{ form_widget(form.phoneNumber, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.phoneNumber) }}
						</div>
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.email) }}
							{{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.email) }}
						</div>
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.plainPassword) }}
							{{ form_widget(form.plainPassword, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.plainPassword) }}
						</div>
					</div>
					<hr>
					<div class="row">
						<div class="col-12 text-center mt-2 mb-4">
							<h5 class="text-rkl-secondary">Información de la empresa</h5>
						</div>
					</div>
					<div class="row">
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.cuit) }}
							{{ form_widget(form.cuit, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 30-50080256-8'}}) }}
							<div id="cuit-format-error" class="text-danger small mt-1" style="display:none;">
								Formato inválido. Usá el formato XX-XXXXXXXX-X (ej: 30-50080256-8).
							</div>
							{{ form_errors(form.cuit) }}
						</div>
						{# Sección extra para no-clientes (CUIT sin match en Calypso) #}
						<div id="no-cliente-section" class="col-12" style="display:none;">
							<div class="row">
								<div class="col-12 col-md-6 mb-3">
									{{ form_label(form.companyName) }}
									{{ form_widget(form.companyName, {'attr': {'class': 'form-control', 'placeholder': 'Ingresá la razón social'}}) }}
									{{ form_errors(form.companyName) }}
								</div>
								<div class="col-12 col-md-6 mb-3">
									{{ form_label(form.domicilio) }}
									{{ form_widget(form.domicilio, {'attr': {'class': 'form-control', 'placeholder': 'Calle y número'}}) }}
									{{ form_errors(form.domicilio) }}
								</div>
								<div class="col-12 col-md-4 mb-3">
									{{ form_label(form.codigoPostal) }}
									{{ form_widget(form.codigoPostal, {'attr': {'class': 'form-control', 'placeholder': 'Ej: 1414'}}) }}
									{{ form_errors(form.codigoPostal) }}
								</div>
								<div class="col-12 col-md-4 mb-3">
									{{ form_label(form.localidad) }}
									{{ form_widget(form.localidad, {'attr': {'class': 'form-control', 'placeholder': 'Localidad'}}) }}
									{{ form_errors(form.localidad) }}
								</div>
								<div class="col-12 col-md-4 mb-3">
									{{ form_label(form.provincia) }}
									{{ form_widget(form.provincia, {'attr': {'class': 'form-control', 'placeholder': 'Provincia'}}) }}
									{{ form_errors(form.provincia) }}
								</div>
								<div class="col-12 col-md-6 mb-3">
									{{ form_label(form.tipoCliente) }}
									{{ form_widget(form.tipoCliente, {'attr': {'class': 'form-select'}}) }}
									{{ form_errors(form.tipoCliente) }}
								</div>
								<div class="col-12 col-md-6 mb-3">
									{{ form_label(form.segmento) }}
									{{ form_widget(form.segmento, {'attr': {'class': 'form-select'}}) }}
									{{ form_errors(form.segmento) }}
								</div>
							</div>
						</div>
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.jobTitle) }}
							{{ form_widget(form.jobTitle, {'attr': {'class': 'form-control'}}) }}
							{{ form_errors(form.jobTitle) }}
						</div>
						<div class="col-12 col-md-6 mb-3">
							{{ form_label(form.role) }}
							<div class="d-flex flex-column gap-2 mt-2">
								{% for child in form.role %}
									<div class="form-check d-flex align-items-center gap-2">
										{{ form_widget(child, {'attr': {'class': 'form-check-input mt-0'}}) }}
										{{ form_label(child, null, {'label_attr': {'class': 'form-check-label mb-0'}}) }}
										{% set desc = child.vars.attr['data-description'] ?? '' %}
										{% if desc %}
											<i class="ri-information-line text-muted"
											   data-bs-toggle="tooltip"
											   data-bs-placement="top"
											   title="{{ desc }}"
											   style="cursor:pointer;font-size:1rem;flex-shrink:0;"></i>
										{% endif %}
									</div>
								{% endfor %}
							</div>
							{{ form_errors(form.role) }}
						</div>

						<div class="mt-4">
							<button class="btn btn-primary w-100" type="submit">Registrarse</button>
						</div>

						{{ form_end(form) }}
						<div class="mt-4 text-center">
							<div class="mt-4 text-center">
								<p class="mb-0">¿Ya tenés cuenta?
									<a href="{{ path('app_login') }}" class="fw-semibold text-rkl-primary text-decoration-underline">
										Iniciá sesión
									</a>
								</p>
							</div>
						</div>
					
					</div>
				</div>
				<!-- end card body -->
			</div>
			<!-- end card -->


		</div>
	</div>
	<!-- end row -->

	<script>
		document.addEventListener('DOMContentLoaded', function() {
			document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
				new bootstrap.Tooltip(el);
			});

			const cuitInput = document.querySelector('input[name*="cuit"]');
			const noClienteSection = document.getElementById('no-cliente-section');
			const cuitFormatError = document.getElementById('cuit-format-error');

			if (!cuitInput || !noClienteSection || !cuitFormatError) {
				console.error('No se encontraron todos los elementos DOM necesarios');
				return;
			}

			const SEARCH_URL = '{{ path("reg_cliente_cuit") }}';
			// Formato: XX-XXXXXXXX-X (2 dígitos, guión, 8 dígitos, guión, 1 dígito)
			const CUIT_REGEX = /^\d{2}-\d{8}-\d{1}$/;
			let searchTimeout;

			function isValidCuitFormat(cuit) {
				return CUIT_REGEX.test(cuit);
			}

			function showFormatError() {
				cuitFormatError.style.display = '';
				cuitInput.classList.add('is-invalid');
			}

			function hideFormatError() {
				cuitFormatError.style.display = 'none';
				cuitInput.classList.remove('is-invalid');
			}

			function showNoClienteSection() {
				noClienteSection.style.display = '';
			}

			function hideNoClienteSection() {
				noClienteSection.style.display = 'none';
				noClienteSection.querySelectorAll('input, select').forEach(el => el.value = '');
			}

			async function searchCompanyByCuit(cuit) {
				if (!isValidCuitFormat(cuit)) {
					showFormatError();
					hideNoClienteSection();
					return;
				}

				hideFormatError();

				try {
					const response = await fetch(SEARCH_URL, {
						method: 'POST',
						headers: {
							'Content-Type': 'application/json',
							'X-Requested-With': 'XMLHttpRequest'
						},
						body: JSON.stringify({ cuit: cuit })
					});

					const data = await response.json();

					if (response.ok && data.success) {
						hideNoClienteSection();
					} else {
						showNoClienteSection();
					}
				} catch (error) {
					console.error('Error en búsqueda:', error);
					showNoClienteSection();
				}
			}

			// Solo dispara la búsqueda al salir del campo (blur)
			cuitInput.addEventListener('blur', function(e) {
				const cuit = e.target.value.trim();
				clearTimeout(searchTimeout);
				if (!cuit) {
					hideFormatError();
					hideNoClienteSection();
					return;
				}
				searchCompanyByCuit(cuit);
			});

			// En input: solo oculta errores/sección si el campo se vacía
			cuitInput.addEventListener('input', function(e) {
				const cuit = e.target.value.trim();
				if (!cuit) {
					clearTimeout(searchTimeout);
					hideFormatError();
					hideNoClienteSection();
				}
			});
		});
	</script>
{% endblock %}