<!DOCTYPE html>
<html lang="es" data-layout="vertical" data-topbar="dark" data-sidebar="light" data-sidebar-size="lg" data-sidebar-image="none" data-preloader="disable" data-theme="default" data-bs-theme="light" data-theme-colors="default">

	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Racklatina
			{% endblock %}
		</title>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta content="Racklatina" name="description"/>
		<meta
		content="Racklatina" name="author"/>

		<!-- App favicon -->
		<link
		rel="shortcut icon" href="{{ asset('images/favicon.ico') }}">

		<!-- jsvectormap css -->
		<link
		href="{{ asset('libs/jsvectormap/css/jsvectormap.min.css') }}" rel="stylesheet" type="text/css"/>

		<!--Swiper slider css-->
		<link
		href="{{ asset('libs/swiper/swiper-bundle.min.css') }}" rel="stylesheet" type="text/css"/>

		<!-- Layout config Js -->
		<script src="{{ asset('js/layout.js') }}"></script>
		<!-- Bootstrap Css -->
		<link
		href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet" type="text/css"/>
		<!-- Icons Css -->
		<link
		href="{{ asset('css/icons.min.css') }}" rel="stylesheet" type="text/css"/>
		<!-- Uppy -->
		<link
		href="{{ asset('uppy/uppy.min.css') }}" rel="stylesheet" type="text/css"/>
		<link	rel="stylesheet"	href="{{ asset('Datatables/datatables.min.css') }}">
		<!-- App Css-->
		<link
		href="{{ asset('libs/sweetalert2/sweetalert2.min.css') }}" rel="stylesheet" type="text/css"/>
		<link
		href="{{ asset('css/app.min.css') }}" rel="stylesheet" type="text/css"/>
		<!-- custom Css-->
		<link href="{{ asset('css/custom.min.css') }}" rel="stylesheet" type="text/css"/>

		<link href="{{ asset('styles/app.css') }}?v={{ 'now'|date('U') }}" rel="stylesheet" type="text/css"/>

		<!-- Estilos críticos inline para evitar problemas de cache -->
		<style>
			/* Horizontal Nav Critical Styles */
			.horizontal-nav {
				background-color: #ffffff !important;
				border-bottom: 0.0625rem solid #e0e0e0 !important;
				padding: 0 !important;
				position: fixed !important;
				top: 4.375rem !important;
				left: 15.625rem !important;
				right: 0 !important;
				z-index: 998 !important;
				box-shadow: 0 0.125rem 0.5rem rgba(0, 0, 0, 0.08) !important;
			}

			[data-sidebar-size="sm"] .horizontal-nav {
				left: 4.375rem !important;
			}

			.nav-horizontal-list {
				display: flex !important;
				flex-direction: row !important;
				list-style: none !important;
				margin: 0 !important;
				padding: 0 1rem !important;
				flex-wrap: wrap !important;
				align-items: center !important;
				gap: 0.5rem !important;
			}

			.nav-horizontal-item {
				margin: 0 !important;
				padding: 0 !important;
			}

			.nav-horizontal-link {
				display: inline-block !important;
				padding: 0.875rem 1.25rem !important;
				color: #333333 !important;
				text-decoration: none !important;
				font-size: 0.9375rem !important;
				font-weight: 500 !important;
				border-bottom: 0.1875rem solid transparent !important;
				white-space: nowrap !important;
			}

			.nav-horizontal-link:hover {
				background-color: rgba(172, 163, 0, 0.08) !important;
				color: var(--rkl-primary) !important;
			}

			.nav-horizontal-link.active {
				color: var(--rkl-primary) !important;
				font-weight: 600 !important;
				border-bottom-color: var(--rkl-primary) !important;
				background-color: rgba(172, 163, 0, 0.05) !important;
			}

			/* Carousel Critical Styles */
			#homeCarousel .carousel-image {
				width: 100% !important;
				height: auto !important;
				max-height: none !important;
				display: block !important;
			}

			#homeCarousel .carousel-link {
				display: block !important;
				position: relative !important;
				z-index: 100 !important;
				cursor: pointer !important;
			}

			#homeCarousel .carousel-control-prev,
			#homeCarousel .carousel-control-next {
				pointer-events: none !important;
			}

			#homeCarousel .carousel-control-prev-icon,
			#homeCarousel .carousel-control-next-icon {
				pointer-events: auto !important;
			}

			#homeCarousel .carousel-indicators {
				pointer-events: none !important;
			}

			#homeCarousel .carousel-indicators button {
				pointer-events: auto !important;
			}

			.main-content {
				padding-top: 4rem !important;
			}

			.page-content {
				padding-top: 1.5rem !important;
			}

			@media (max-width: 1199px) {
				.horizontal-nav {
					display: none !important;
				}
				.main-content {
					padding-top: 0 !important;
				}
			}

			/* Menu Active Styles */
			.navbar-menu .navbar-nav .nav-link.active,
			.navbar-menu .navbar-nav .nav-link.active:hover,
			.navbar-menu .navbar-nav .nav-link.active:focus {
				background-color: #3D4F5E !important;
				color: #ffffff !important;
			}

			.navbar-menu .navbar-nav .nav-link.active i {
				color: var(--rkl-primary) !important;
			}
		</style>

		{% block stylesheets %}{% endblock %}

			
		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		<!-- Begin page -->
		<div id="layout-wrapper">
			{{ include('header.html.twig') }}

			<!-- ========== App Menu ========== -->
			{{ include('menu.html.twig') }}<!-- Left Sidebar End -->
			<!-- Vertical Overlay--><div class="vertical-overlay"> </div>

			<!-- ========== Barra de navegación horizontal ========== -->
			{{ include('horizontal_nav.html.twig') }}

			<!-- ============================================================== -->
			<!-- Start right Content here -->
			<!-- ============================================================== -->

				<div class="main-content"> <div class="page-content"> {% block body %}{% endblock %}
					<footer class="footer p-0" style="margin-top: -124px;">
						<div class="container-fluid">
							<div class="row">
								<div class="col-12 p-0 text-center">
									{# <p style="font-size: 12px;">&copy;
										{{ "now"|date("Y") }}
										Racklatina S.A. Todos los derechos reservados.</p> #}
									<img src="{{ asset('images/separador.png') }}" style="padding:0px -24px;margin:0;border:0;width:100%; height:100px" alt="Logo Racklatina" class="logo-footer">
								</div>
							</div>
						</div>
					</footer>
				</div>
			</div>
			
			<!-- Modal de Contacto -->
			{{ include('contacto.html.twig') }}

			<!-- Modal de Encuesta de Satisfacción -->
			{{ include('encuesta_modal.html.twig') }}
			<!-- Modal Encuesta NPS Anual -->
			{{ include('encuesta_nps_modal.html.twig') }}
			<!-- JAVASCRIPT -->
			 <script>
				var esDatatable =  "{{ asset('lang/es-ES.json') }}";
				</script>

			<script>
				window.assets = {
choicesJs: "{{ asset('libs/choices.js/public/assets/scripts/choices.min.js') }}",
flatpickrJs: "{{ asset('libs/flatpickr/flatpickr.min.js') }}",
langJson: "{{ asset('lang/en.json') }}",
bellSvg: "{{ asset('images/svg/bell.svg') }}",
flag: {
us: "{{ asset('images/flags/us.svg') }}",
spain:"{{ asset('images/flags/spain.svg') }}",
germany:"{{ asset('images/flags/germany.svg') }}",
italy:"{{ asset('images/flags/italy.svg') }}",
russia:"{{ asset('images/flags/russia.svg') }}",
china:"{{ asset('images/flags/china.svg') }}",
french:"{{ asset('images/flags/french.svg') }}",
ae:"{{ asset('images/flags/ae.svg') }}"
}

};
			</script>

			<script src="{{ asset('libs/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
			<script src="{{ asset('libs/simplebar/simplebar.min.js') }}"></script>
			<script src="{{ asset('libs/node-waves/waves.min.js') }}"></script>
			<script src="{{ asset('libs/feather-icons/feather.min.js') }}"></script>
			<script src="{{ asset('js/pages/plugins/lord-icon-2.1.0.js') }}"></script>
			<script src="{{ asset('js/plugins.js') }}"></script>
			<script src="{{ asset('js/jquery-3.7.1.min.js') }}"></script>
			<script src="{{ asset('Datatables/datatables.min.js') }}"></script>
			<script src="{{ asset('libs/sweetalert2/sweetalert2.min.js') }}"></script>
			<script src="{{ asset('uppy/uppy.min.js') }}"></script>
			{{ include('_contacto_js.html.twig') }}

			<!-- App js -->
			<script src="{{ asset('js/app.js') }}"></script>
	</body>
</html>
