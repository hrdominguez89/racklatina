{% extends 'base_public.html.twig' %}

{% block title %}Racklatina - Portal clientes
{% endblock %}

{% block body %}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 col-xl-5">
        <div class="card mt-4 card-bg-fill">

            <div class="card-body p-4">
                <div class="text-center mt-2">
                    <h5 class="text-rkl-secondary">Tu contraseña venció</h5>
                    <p class="text-muted">Por seguridad, tenés que definir una nueva contraseña antes de continuar.</p>
                </div>

                <div class="p-2">
                    <form method="post">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('force_change_password') }}">
                        <div class="mb-3">
                            <label class="form-label" for="password-input">Nueva contraseña</label>
                            <div class="position-relative auth-pass-inputgroup">
                                <input type="password" class="form-control pe-5 password-input" name="password" onpaste="return false" placeholder="Ingrese una contraseña" id="password-input" aria-describedby="passwordInput" pattern="(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z\d\s]).{8,}" required>
                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="password-addon">
                                    <i class="ri-eye-fill align-middle"></i>
                                </button>
                            </div>
                            <div id="passwordInput" class="form-text">
                                <span class="fs-12 mb-2 d-block">Mínimo <b>8 caracteres</b></span>
                                <span class="fs-12 mb-2 d-block">Al menos una <b>letra</b></span>
                                <span class="fs-12 mb-2 d-block">Al menos un <b>número</b></span>
                                <span class="fs-12 mb-0 d-block">Al menos un <b>símbolo</b> (ej. ! @ # $ % &amp;)</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="confirm-password-input">Confirmar contraseña</label>
                            <div class="position-relative auth-pass-inputgroup mb-3">
                                <input type="password" class="form-control pe-5 password-input" onpaste="return false" name="confirm_password" placeholder="Confirme la contraseña" pattern="(?=.*[A-Za-z])(?=.*\d)(?=.*[^A-Za-z\d\s]).{8,}" id="confirm-password-input" required>
                                <button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon material-shadow-none" type="button" id="confirm-password-input-btn">
                                    <i class="ri-eye-fill align-middle"></i>
                                </button>
                            </div>
                        </div>

                        <div class="mt-4">
                            <button class="btn btn-primary w-100" type="submit">Cambiar contraseña</button>
                        </div>

                        <div class="mt-3 text-center">
                            <a href="{{ path('app_logout') }}" class="text-muted small">Cerrar sesión</a>
                        </div>
                    </form>
                </div>
            </div>
            <!-- end card body -->
        </div>
        <!-- end card -->
    </div>
</div>

{% endblock %}
