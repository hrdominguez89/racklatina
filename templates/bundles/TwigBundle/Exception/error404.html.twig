<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Página no encontrada – Racklatina</title>
    <link rel="shortcut icon" href="{{ asset('images/favicon.ico') }}">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: #f4f5f7;
        }

        /* NAV */
        .topbar {
            background: #ffffff;
            border-bottom: 3px solid #aca300;
            padding: 0 2rem;
            height: 64px;
            display: flex;
            align-items: center;
            box-shadow: 0 2px 8px rgba(0,0,0,.08);
        }
        .topbar img { height: 38px; }

        /* MAIN */
        .error-wrap {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 4rem 1.5rem;
            text-align: center;
        }

        /* ILLUSTRATION */
        .illustration-wrap {
            position: relative;
            width: 220px;
            height: 180px;
            margin-bottom: 2.5rem;
        }

        /* CODE */
        .code-badge {
            font-size: 7rem;
            font-weight: 900;
            letter-spacing: -4px;
            line-height: 1;
            color: #e8e9ec;
            user-select: none;
            margin-bottom: 0.5rem;
        }

        .error-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: #1e2733;
            margin-bottom: 0.6rem;
        }
        .error-sub {
            font-size: 0.95rem;
            color: #6b7280;
            margin-bottom: 2rem;
            max-width: 340px;
        }

        .btn-home {
            display: inline-block;
            background: #aca300;
            color: #ffffff;
            font-size: 0.9rem;
            font-weight: 600;
            text-decoration: none;
            padding: 0.65rem 1.8rem;
            border-radius: 6px;
            transition: background 0.2s;
            letter-spacing: 0.3px;
        }
        .btn-home:hover { background: #bfb535; color: #fff; text-decoration: none; }

        /* FOOTER */
        .page-footer {
            text-align: center;
            padding: 1.25rem;
            font-size: 0.78rem;
            color: #adb5bd;
        }
    </style>
</head>
<body>

    <header class="topbar">
        <a href="{{ path('app_home') }}">
            <img src="{{ asset('logo-racklatina-light.png') }}" alt="Racklatina"
                 onerror="this.src='{{ asset('assets/images/logo-dark-EsNP9Mv.png') }}'">
        </a>
    </header>

    <main class="error-wrap">

        <div class="code-badge">404</div>

        <svg width="160" height="120" viewBox="0 0 160 120" fill="none"
             xmlns="http://www.w3.org/2000/svg" style="margin-bottom:2rem" aria-hidden="true">
            <!-- laptop body -->
            <rect x="14" y="12" width="132" height="84" rx="7" fill="#dde1e9"/>
            <rect x="22" y="20" width="116" height="68" rx="4" fill="#eef0f4"/>
            <!-- screen shine -->
            <rect x="22" y="20" width="116" height="68" rx="4"
                  fill="url(#shine)" opacity="0.5"/>
            <!-- base -->
            <rect x="4" y="96" width="152" height="11" rx="5.5" fill="#c9cdd6"/>
            <rect x="58" y="96" width="44" height="5" rx="2.5" fill="#b5bac5"/>
            <!-- circle -->
            <circle cx="80" cy="54" r="22" fill="#c9cdd6"/>
            <circle cx="80" cy="54" r="16" fill="#dde1e9"/>
            <!-- question mark -->
            <text x="80" y="62" text-anchor="middle"
                  font-size="20" font-weight="800" fill="#8e97a8"
                  font-family="Arial,sans-serif">?</text>
            <!-- magnifier -->
            <line x1="96" y1="70" x2="110" y2="84"
                  stroke="#c9cdd6" stroke-width="5" stroke-linecap="round"/>
            <!-- accent dot -->
            <circle cx="110" cy="84" r="6" fill="#aca300" opacity="0.8"/>
            <defs>
                <linearGradient id="shine" x1="22" y1="20" x2="138" y2="88" gradientUnits="userSpaceOnUse">
                    <stop offset="0%" stop-color="#fff" stop-opacity="0.6"/>
                    <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
                </linearGradient>
            </defs>
        </svg>

        <p class="error-title">Parece que esta página no existe</p>
        <p class="error-sub">La URL que ingresaste no corresponde a ninguna sección del portal.</p>

        <a href="{{ path('app_home') }}" class="btn-home">Ir a la página principal</a>

    </main>

    <footer class="page-footer">
        &copy; {{ "now"|date("Y") }} Racklatina S.A. Todos los derechos reservados.
    </footer>

</body>
</html>
